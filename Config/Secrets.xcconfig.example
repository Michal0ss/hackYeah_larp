// Copy to Config/Secrets.xcconfig (gitignored).
// App token for the backend: one of the values in the server's FORMA_APP_TOKENS (empty while the server runs
// without tokens, which is the default for `make dev`). The model API key lives only on the server.
FORMA_API_TOKEN = REPLACE-ME
// Where the backend runs. Phone: the Mac's address in the local network (or the deployed URL).
// FORMA_API_URL = http:/$()/192.168.1.20:8000
