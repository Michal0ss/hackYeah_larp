// Shared build settings. Do not put secrets here.
// Per-developer overrides go to Config/Local.xcconfig (gitignored).
// Secrets go to Config/Secrets.xcconfig (gitignored).

APP_BUNDLE_ID = com.michal0ss.forma
DEVELOPMENT_TEAM =

// hackGYM backend (backend/). The app never talks to the model directly and holds no model key.
// "//" starts a comment in xcconfig, hence the $() trick. On a phone use the Mac's address, e.g. http://192.168.1.20:8000
FORMA_API_URL = http:/$()/localhost:8000
FORMA_API_TOKEN =

#include? "Local.xcconfig"
#include? "Secrets.xcconfig"
