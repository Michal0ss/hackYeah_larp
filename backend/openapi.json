            "type": "integer"
          },
          "exerciseId": {
            "maxLength": 60,
            "title": "Exerciseid",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingDigest"
            },
            "maxItems": 6,
