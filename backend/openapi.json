  "info": {
    "description": "\nBackend of the Forma app. Stateless: no database, no stored videos, no stored health data.\n\n* `GET /health`: liveness (no auth)\n* `/v1/*`: needs `Authorization: Bearer <app token>` when `FORMA_APP_TOKENS` is set; send a stable random\n  `X-Device-Id` (UUID) so rate limits are per device\n* every error is `{\"error\": {\"code\", \"message\", \"requestId\"}}`\n",
    "title": "Forma API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness and basic facts (no auth)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/catalog": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified (If-None-Match matched)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid app token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded (see Retry-After)."
          }
        },
        "summary": "Exercise catalog",
        "tags": [
          "content"
        ]
      }
    },
    "/v1/coach/chat": {
      "post": {
        "description": "Stateless: send the whole conversation every time. The model may ask for a tool; the **app** runs it on local data and posts again with a `tool_result` block.\n\n`stream: true` (default) answers with `text/event-stream`:\n\n- `event: delta` `data: {\"text\": \"...\"}` a piece of the answer\n- `event: tool_use` `data: {\"id\", \"name\", \"input\"}` the model wants a tool (a `done` event follows)\n- `event: done` `data: {\"stopReason\", \"usage\": {\"inputTokens\", \"outputTokens\"}}` last event\n- `event: error` `data: {\"code\", \"message\", \"requestId\"}` terminal error after the stream started\n\n`stream: false` answers with one JSON object. Problems detected before the model is called (invalid conversation, consent, limits) are normal HTTP errors in both modes.",
        "operationId": "coachChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachChatResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "JSON when `stream` is false, `text/event-stream` otherwise."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid app token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded (see Retry-After)."
          },
          "503": {
            "description": "The model is unavailable (non-streaming only; a stream sends an `error` event)."
          }
        },
        "summary": "AI trainer chat (SSE stream or one JSON response)",
        "tags": [
          "coach"
        ]
      }
    },
    "/v1/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified (If-None-Match matched)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid app token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded (see Retry-After)."
          }
        },
        "summary": "Remote configuration (scoring, insights, tempo)",
        "tags": [
          "content"
        ]
      }
    },
    "/v1/plans/generate": {
      "post": {
        "description": "The model proposes a plan, the server validates it against the catalog and the profile. When the model is unavailable or its plan is invalid the response is a template plan (`plan.source = template`) with a warning, never an error. Warnings: `ai_unavailable`, `ai_invalid_plan`, `ai_mock`, `avoid_text_not_applied`.",
        "operationId": "generatePlan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanGenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanGenerateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid app token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded (see Retry-After)."
          }
        },
        "summary": "Generate a weekly plan for a profile",
        "tags": [
          "plans"
        ]
      }
    },
    "/v1/texts/recommendation": {
      "post": {
        "description": "The decision is made on the phone; this only rewrites the text. The result is safety-checked and falls back to a template text (`source = template`) with a warning, never an error. Warnings: `ai_unavailable`, `ai_text_rejected`, `ai_mock`.",
        "operationId": "recommendationText",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationTextResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid app token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit exceeded (see Retry-After)."
          }
        },
        "summary": "Friendly wording for today's recommendation",
        "tags": [
          "texts"
        ]
      }
    }
  }
}
