          "adaptationNote": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptationnote"
          },
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/ExerciseDigest"
            },
            "maxItems": 12,
            "title": "Exercises",
            "type": "array"
          },
          "status": {
            "enum": [
              "planned",
              "done",
              "adapted",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "maxLength": 80,
            "title": "Title",
            "type": "string"
          },
          "weekday": {
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Weekday",
            "type": "integer"
          }
        },
        "required": [
          "weekday",
          "title",
          "status"
        ],
        "title": "SessionDigest",
        "type": "object"
      },
