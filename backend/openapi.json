            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptationnote"
          },
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/PlannedExercise"
            },
            "title": "Exercises",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "default": "planned",
