{
  "components": {
    "schemas": {
      "CareFlag": {
        "properties": {
          "reason": {
            "maxLength": 300,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "CareFlag",
        "type": "object"
      },
      "CatalogResponse": {
        "properties": {
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/ExerciseItem"
            },
            "title": "Exercises",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "exercises"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "text": "#/components/schemas/TextBlock",
                      "tool_result": "#/components/schemas/ToolResultBlock",
                      "tool_use": "#/components/schemas/ToolUseBlock"
                    },
                    "propertyName": "type"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextBlock"
                    },
                    {
                      "$ref": "#/components/schemas/ToolUseBlock"
                    },
                    {
                      "$ref": "#/components/schemas/ToolResultBlock"
                    }
                  ]
                },
                "type": "array"
              }
            ],
            "title": "Content"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "CoachChatRequest": {
        "properties": {
          "consent": {
            "$ref": "#/components/schemas/Consent"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoachContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "stream": {
            "default": true,
            "title": "Stream",
            "type": "boolean"
          }
        },
        "required": [
          "messages"
        ],
        "title": "CoachChatRequest",
        "type": "object"
      },
      "CoachChatResponse": {
        "properties": {
          "stopReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopreason"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "toolUses": {
            "items": {
              "$ref": "#/components/schemas/ToolUseOut"
            },
            "title": "Tooluses",
            "type": "array"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "text"
        ],
        "title": "CoachChatResponse",
        "type": "object"
      },
      "CoachContext": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          },
