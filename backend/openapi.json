            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkoutContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "profile"
        ],
        "title": "CoachContext",
        "type": "object"
      },
      "ConfigResponse": {
        "description": "Remote configuration. Each section is owned by one person (see content/README.md).",
        "properties": {
          "insights": {
            "additionalProperties": true,
            "title": "Insights",
            "type": "object"
          },
          "scoring": {
            "additionalProperties": true,
            "title": "Scoring",
            "type": "object"
          },
          "tempo": {
            "additionalProperties": true,
            "title": "Tempo",
            "type": "object"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "scoring",
          "insights",
          "tempo"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "Consent": {
        "description": "The user's consent to pass health data (as summaries) to the model. Mirrors DataConsent in the app.",
        "properties": {
          "health": {
            "default": false,
            "title": "Health",
            "type": "boolean"
          }
        },
        "title": "Consent",
        "type": "object"
      },
      "DailyRecommendation": {
        "properties": {
          "careFlag": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CareFlag"
              },
              {
                "type": "null"
              }
            ]
          },
          "date": {
            "format": "date-time",
            "title": "Date",
            "type": "string"
          },
          "decision": {
            "enum": [
              "train",
              "adapt",
              "rest"
            ],
            "title": "Decision",
            "type": "string"
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/RecommendationFactor"
            },
            "maxItems": 10,
            "title": "Factors",
            "type": "array"
          },
          "headline": {
            "maxLength": 120,
            "title": "Headline",
            "type": "string"
          },
          "isSimulated": {
            "default": false,
            "title": "Issimulated",
            "type": "boolean"
          },
          "suggestedAction": {
            "maxLength": 300,
            "title": "Suggestedaction",
            "type": "string"
          }
        },
        "required": [
          "date",
          "decision",
          "headline",
          "factors",
          "suggestedAction"
        ],
        "title": "DailyRecommendation",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorField"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorField": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "ErrorField",
        "type": "object"
      },
      "ExerciseDigest": {
        "description": "One planned exercise as the coach sees it. Only the id: the server knows the name from the catalog.",
        "properties": {
          "exerciseId": {
            "maxLength": 60,
            "title": "Exerciseid",
            "type": "string"
          },
          "repsMax": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Repsmax",
            "type": "integer"
          },
          "repsMin": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Repsmin",
            "type": "integer"
          },
          "restSeconds": {
            "maximum": 600.0,
            "minimum": 0.0,
            "title": "Restseconds",
            "type": "integer"
          },
          "sets": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Sets",
            "type": "integer"
          },
          "tempo": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tempo"
          }
        },
        "required": [
          "exerciseId",
          "sets",
          "repsMin",
          "repsMax",
          "restSeconds"
        ],
        "title": "ExerciseDigest",
        "type": "object"
      },
      "ExerciseItem": {
        "properties": {
          "defaultTempo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TempoSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "equipment": {
            "enum": [
              "none",
              "dumbbells",
              "gym"
            ],
            "title": "Equipment",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "level": {
            "enum": [
              "beginner",
              "intermediate"
            ],
            "title": "Level",
            "type": "string"
          },
          "movementTags": {
            "items": {
              "enum": [
                "jumps",
                "deepLunges",
                "overheadPress",
                "barbellDeadlift",
                "deepSquats",
                "loadedPushups"
              ],
              "type": "string"
            },
            "title": "Movementtags",
            "type": "array"
          },
          "muscleGroup": {
            "title": "Musclegroup",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pattern": {
            "enum": [
              "squat",
              "hinge",
              "lunge",
              "push",
              "pull",
              "core",
              "cardio"
            ],
            "title": "Pattern",
            "type": "string"
          },
          "substituteIds": {
            "items": {
              "type": "string"
            },
            "title": "Substituteids",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "supportsAnalysis": {
            "default": false,
            "title": "Supportsanalysis",
            "type": "boolean"
          },
          "timed": {
            "default": false,
            "title": "Timed",
            "type": "boolean"
          },
          "videoURL": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Videourl"
          }
        },
        "required": [
          "id",
          "name",
          "muscleGroup",
          "equipment",
          "level",
          "summary",
          "pattern"
        ],
        "title": "ExerciseItem",
        "type": "object"
      },
      "FindingDigest": {
        "description": "A technique or tempo finding of a set without its long description.",
        "properties": {
          "id": {
            "maxLength": 60,
            "title": "Id",
            "type": "string"
          },
          "repsAffected": {
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Repsaffected",
            "type": "integer"
          },
          "repsTotal": {
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Repstotal",
            "type": "integer"
          },
          "severity": {
            "enum": [
              "good",
              "minor",
              "major"
            ],
            "title": "Severity",
            "type": "string"
          },
          "title": {
            "maxLength": 80,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "repsAffected",
          "repsTotal"
        ],
