# Copy to .env (git-ignored). Nothing here is required: without a key the server runs in offline mock mode.
FORMA_ENV=dev
# auto = real model when a key is set (Gemini first, then Anthropic), otherwise mock. Force mock: FORMA_AI_MODE=mock
FORMA_AI_MODE=auto
# Use a key from a paid (billing-enabled) Google AI project: on the free tier Google may use prompts to improve
# its products, and our prompts carry health summaries.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (default: the active provider's models, see app/config.py PROVIDER_MODELS)
# FORMA_COACH_MODEL=
# FORMA_PLAN_MODEL=
# FORMA_TEXT_MODEL=
# Comma-separated bearer tokens the app may use. Empty = auth off (dev only). Required when FORMA_ENV=prod.
FORMA_APP_TOKENS=
