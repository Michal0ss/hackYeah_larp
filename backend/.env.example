# Copy to .env (git-ignored). Nothing here is required: without a key the server runs in offline mock mode.
FORMA_ENV=dev
# auto = real model when a key is set, otherwise mock. Force mock to be safe: FORMA_AI_MODE=mock
FORMA_AI_MODE=auto
ANTHROPIC_API_KEY=
# Comma-separated bearer tokens the app may use. Empty = auth off (dev only). Required when FORMA_ENV=prod.
FORMA_APP_TOKENS=
