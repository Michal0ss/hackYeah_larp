# Copy to .env (git-ignored). Nothing here is required: without a key the server runs in offline mock mode.
FORMA_ENV=dev
# auto = Gemini when GEMINI_API_KEY is set, otherwise mock. Force mock to be safe: FORMA_AI_MODE=mock
FORMA_AI_MODE=auto
# Use a key from a paid (billing-enabled) Google AI project: on the free tier Google may use prompts to improve
# its products (our prompts carry health summaries) and the daily quota is tiny (20 requests per model).
GEMINI_API_KEY=
# Optional: models. The first is used, the others take over when it is retired, out of quota or down.
# FORMA_COACH_MODEL=gemini-3.5-flash
# FORMA_PLAN_MODEL=gemini-3.5-flash
# FORMA_TEXT_MODEL=gemini-3.5-flash
# FORMA_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Comma-separated bearer tokens the app may use. Empty = auth off (dev only). Required when FORMA_ENV=prod.
FORMA_APP_TOKENS=
