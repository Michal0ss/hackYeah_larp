# Only what the API needs at runtime goes to Vercel: api/, backend/app (with its prompts), content/, requirements.txt.
# Patterns are anchored with "/" and matching is case-insensitive: a plain "App/" would also remove backend/app/.
/App/
/Packages/
/Config/
/Forma.xcodeproj/
/scripts/
/backend/.venv/
/backend/tests/
/backend/evals/
/backend/scripts/
**/__pycache__/
/README.md
/PROJECT.md
/WORKINGPLAN.md
/CLAUDE.md
